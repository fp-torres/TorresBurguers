# =====================================================================
#  Comestra em Docker: configuração dos containers (docker-compose.yml)
#
#  Copie este arquivo para .env.docker e preencha os três segredos marcados como OBRIGATÓRIO:
#    bash/Git Bash:  cp .env.docker.example .env.docker
#    PowerShell:     Copy-Item .env.docker.example .env.docker
#  O .env.docker tem segredos: NUNCA o versione (ele está no .gitignore). Este exemplo não tem nenhum.
#
#  Lido pelos serviços db e api (env_file): o arquivo INTEIRO vai para o ambiente desses containers.
#  Os valores fixos da composição (DB_HOST, DB_PORT, DB_USERNAME, DB_DATABASE, HOST, PORT, UPLOADS_DIR,
#  DB_SYNCHRONIZE=false e DB_MIGRATIONS_RUN=true) estão no docker-compose.yml e têm prioridade sobre este arquivo.
#  Referência completa das variáveis da API: backend/.env.example · Guia: docs/saas/docker.md
#
#  Formato: NOME=valor, sem espaços em volta do "=". O "$" é especial: ${NOME} lê outra variável deste arquivo
#  (use $$ para um "$" literal). Prefira segredos só com letras, números, "+", "/", "=", "-" e "_".
#  Gerar segredos (qualquer terminal com o Docker; não precisa de Node instalado):
#    docker run --rm node:22-bookworm-slim node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  Depois de mudar este arquivo: docker compose up -d   (recria os containers afetados)
# =====================================================================

# --- Modo de execução ------------------------------------------------------------
# development = DEMONSTRAÇÃO LOCAL (padrão deste exemplo), para testar tudo neste computador:
#   - na primeira subida cria a loja demo (/loja/demo), a equipe demo (admin, cozinha, entregador, atendente) e
#     um cliente, com as senhas PÚBLICAS do README (ex.: admin@comestra.com.br / Admin@123);
#   - pagamentos do delivery em sandbox (sem MP_ACCESS_TOKEN): cartão de teste e PIX de teste aprovado sozinho;
#   - com MAIL_DRIVER=log, o texto completo dos e-mails (com os links de convite e de redefinição de senha)
#     aparece em "docker compose logs api".
#   Use só com o site restrito a este computador (padrão: porta 8080 em 127.0.0.1), nunca exposto na rede ou
#   na internet: qualquer pessoa que conheça as senhas públicas entra como administrador da loja demo.
# production = PRODUÇÃO: nenhuma conta de demonstração, sandbox recusado, Swagger desligado e HSTS ligado.
#   Veja o bloco "PRODUÇÃO" no fim deste arquivo.
# Vazio ou outro valor também conta como produção (fail closed).
NODE_ENV=development

# --- Banco de dados (serviço db, PostgreSQL 18) ------------------------------------
# OBRIGATÓRIO. Senha do usuário "comestra" do banco "comestra" (o banco não tem porta publicada no computador).
# Gere 32 bytes aleatórios em hex (comando no topo do arquivo).
# Atenção: o PostgreSQL só grava esta senha quando CRIA o volume (primeira subida). Trocar o valor depois não muda
# a senha do banco: veja "Trocar a senha do banco" em docs/saas/docker.md.
POSTGRES_PASSWORD=
# A API usa a mesma senha. Não altere esta linha.
DB_PASSWORD=${POSTGRES_PASSWORD}

# --- Segredos da API -------------------------------------------------------------
# OBRIGATÓRIO. Assina os tokens de login: pelo menos 32 caracteres aleatórios (sugestão: 48 bytes em hex).
# Trocar o valor encerra todas as sessões abertas.
#   docker run --rm node:22-bookworm-slim node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Validade do token (7d, 12h, 30m...). Padrão: 7d
JWT_EXPIRES_IN=7d
# OBRIGATÓRIO. Chave AES-256 (32 bytes em base64 ou hex) que cifra o Access Token do Mercado Pago de cada loja.
# Guarde uma cópia em local seguro: trocá-la torna ilegíveis as credenciais já gravadas pelas lojas.
#   docker run --rm node:22-bookworm-slim node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Endereços públicos -------------------------------------------------------------
# Endereço do site visto pelo navegador (links dos e-mails de convite e de redefinição de senha), sem barra no fim.
APP_WEB_URL=http://localhost:8080
# Origens liberadas no CORS (o site chama a API na mesma origem; isto vale para outros clientes de navegador).
CORS_ORIGINS=http://localhost:8080
# Endereço público da API (base absoluta do logo das lojas nos e-mails HTML). Vazio = e-mails sem logo.
PUBLIC_API_URL=http://localhost:8080/api
# Proxies na frente da API. O Nginx do serviço web é UM salto: 1. Nunca use true (o Express passaria a aceitar o
# IP escrito pelo próprio cliente no X-Forwarded-For e os limites por IP deixariam de valer).
# Com outro proxy HTTPS na frente do Nginx (Caddy, Traefik, balanceador): 2. Veja docs/saas/docker.md.
TRUST_PROXY=1

# --- Sessão do site (login em cookie) -------------------------------------------------
# O site entra com um token de acesso curto, guardado só na memória da aba, e um refresh num cookie HttpOnly
# (SameSite=Strict, Path=/, sem Domain). Em http (este exemplo, NODE_ENV=development) o cookie se chama
# comestra_rt, sem Secure; em produção vira __Host-comestra_rt com Secure (exige HTTPS na frente do Nginx).
# No Docker o site e a API têm a MESMA origem (o Nginx repassa /api/), então o cookie é do próprio site.
# O app mobile e outras integrações não pedem o cookie e seguem com o token de JWT_EXPIRES_IN, como antes.
# true (padrão) ou false: false para de abrir sessões em cookie na hora (as já abertas renovam até vencer) e o
# site volta ao token no navegador.
AUTH_WEB_COOKIE=true
# Validade do token de acesso das sessões em cookie, de 1m a 60m. Padrão: 15m
JWT_ACCESS_EXPIRES_IN=15m
# Origens que podem abrir e renovar a sessão em cookie (e recebem credenciais no CORS), separadas por vírgula.
# Vazio = CORS_ORIGINS + a origem de APP_WEB_URL (aqui, http://localhost:8080). Nunca use "*".
# Em produção sem nenhuma origem explícita, a sessão em cookie fica desligada (aviso no log).
AUTH_COOKIE_ORIGINS=
# Opcionais (vazio = padrão): AUTH_SESSION_MAX_AGE (validade total da sessão; padrão = JWT_EXPIRES_IN),
# AUTH_REFRESH_GRACE_SECONDS (tolerância do refresh anterior, 0 a 120; padrão 30),
# AUTH_COOKIE_SAMESITE (strict ou lax; padrão strict) e RATE_LIMIT_REFRESH (renovações por IP; padrão 120/300).

# --- Demonstração ------------------------------------------------------------------
# Contas e loja de demonstração (só com NODE_ENV=development; em produção nunca são criadas e true gera erro no log).
SEED_DEMO_USERS=true
# Superadmin de demonstração com senha PÚBLICA: deixe false. O superadmin é criado pelo comando (abaixo).
SEED_DEMO_SUPERADMIN=false
# Sandbox de pagamentos. Vazio = ligado em development quando MP_ACCESS_TOKEN está vazio ou é de teste (TEST-).
PAYMENT_SANDBOX=
# No sandbox, segundos até um PIX criado ser considerado pago (padrão: 5)
PIX_SANDBOX_APPROVAL_SECONDS=5
# Swagger (/api da API). Desligado no Docker: atrás do prefixo /api do Nginx a página não funciona direito.
# Para consultar a documentação interativa, use o ambiente de desenvolvimento (npm run start:dev → http://localhost:3000/api).
SWAGGER_ENABLED=false

# --- Identidade e lojas --------------------------------------------------------------
# Nome da PLATAFORMA (logs, e-mails). Vazio = Comestra. O nome exibido no SITE vem do build (VITE_APP_NAME,
# lido do ambiente do terminal no "docker compose build").
APP_NAME=
# Loja das rotas antigas sem slug (app mobile). Vazio = a loja padrão escolhida no superpainel.
DEFAULT_STORE_SLUG=
# Fuso das lojas sem fuso próprio. Vazio = America/Sao_Paulo
STORE_TIME_ZONE=

# --- Entrega por distância: localização dos endereços no mapa (opcional) ------------------
# Só é usada quando alguma loja escolhe "Por distância (km)" em Configurações → Entrega. Sem nenhuma loja assim, a
# API não envia endereços a nenhum serviço de mapa. O container da API precisa de saída para a internet.
# Chave do Google Maps Platform (Geocoding API + Routes API; serviço PAGO acima da cota gratuita mensal). Vazio = sem
# Google (usa Nominatim/OpenStreetMap e AwesomeAPI, gratuitos). Custos e termos: docs/saas/operacao.md, seção 8.4.
GOOGLE_MAPS_API_KEY=
# Ordem dos serviços. Vazio = google,nominatim,awesomeapi · "none" desliga a localização
GEOCODING_PROVIDERS=
# Contato (e-mail ou site) no User-Agent enviado ao Nominatim (a política de uso dele pede). Ex.: ops@seudominio.com.br
GEOCODING_CONTACT=
# Nominatim próprio ou contratado. Vazio = https://nominatim.openstreetmap.org (público, 1 requisição por segundo)
GEOCODING_NOMINATIM_URL=

# --- E-mail transacional ---------------------------------------------------------------
# log = nada é enviado (em development o texto vai para "docker compose logs api"). smtp = envia de verdade.
MAIL_DRIVER=log
# Com smtp: servidor, porta (587 STARTTLS ou 465 com SMTP_SECURE=true), usuário/senha e remetente.
# Um SMTP rodando no próprio computador é alcançado pelo nome host.docker.internal (não "localhost").
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Remetente: "Nome <endereco@dominio>" (com aspas por causa dos espaços e dos sinais < >)
MAIL_FROM=
# Contas: verificação e troca de e-mail. compat (padrão) mantém as rotas antigas usadas pelo app mobile; o site usa
# /account/* (troca confirmada no endereço novo e "Não fui eu" no antigo). strict ainda não existe nesta versão
# (a API segue em compat e avisa no log). Com MAIL_DRIVER=log, os links aparecem em "docker compose logs api".
ACCOUNT_SECURITY_MODE=compat

# --- Pagamentos do delivery (Mercado Pago) ----------------------------------------------
# Cada loja informa as próprias credenciais no painel (Configurações → Pagamentos). Estas valem só para a loja
# padrão sem credencial própria. Vazio = sandbox em development.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# URL pública https do webhook (ex.: https://app.seudominio.com.br/api/payment/webhook). Vazio = conciliação
# automática pela consulta de status.
MP_NOTIFICATION_URL=
# Validade do QR Code PIX em minutos (padrão: 30)
PIX_EXPIRATION_MINUTES=

# --- Cobrança da assinatura SaaS (loja → plataforma) ------------------------------------
# MANUAL = faturas registradas no superpainel · MERCADO_PAGO = assinatura recorrente (exige a conta MP da plataforma)
SAAS_BILLING_PROVIDER=MANUAL
MP_SAAS_ACCESS_TOKEN=
MP_SAAS_WEBHOOK_SECRET=
# Página de retorno depois do pagamento da assinatura (ex.: https://app.seudominio.com.br/subscription)
SAAS_BILLING_BACK_URL=

# --- Banco sob carga (vazio = padrão) ----------------------------------------------------------
# Conexões do pool da API (1 a 200). Padrão: 10
DB_POOL_SIZE=
# Tempo máximo de uma consulta da API, em ms (0 desliga). Padrão: 60000, o mesmo prazo do proxy_read_timeout (60 s)
# do Nginx em /api/. Acima de 60000, aumente também o proxy_read_timeout em frontend-web/nginx.conf.
DB_STATEMENT_TIMEOUT_MS=
# Espera máxima por uma conexão livre do pool, em ms (esgotada: a requisição falha com 500). Padrão: 30000
DB_POOL_ACQUIRE_TIMEOUT_MS=
# Cache dos números do superpainel (painel e financeiro), em ms (0 desliga). Padrão: 30000
PLATFORM_INSIGHTS_CACHE_MS=

# --- Manutenção e limites ------------------------------------------------------------------
# Limpeza automática das imagens sem uso, de N em N horas (ex.: 24). Vazio = desligada (há o botão no superpainel).
UPLOADS_CLEANUP_INTERVAL_HOURS=
# Limites de tentativas (login, cadastro, pedidos...). Vazio = ligados. Ajuste fino: RATE_LIMIT_<NOME>=limite/segundos
RATE_LIMIT_ENABLED=
# Banner de futebol (token gratuito de football-data.org). Vazio = sugestão do dia.
FOOTBALL_DATA_TOKEN=

# --- Superadministrador ----------------------------------------------------------------------
# O papel global nunca é concedido pela web. Com os containers no ar, crie o primeiro superadmin com:
#   docker compose exec api npm run platform:superadmin:prod -- --email=ops@seudominio.com.br --name="Seu Nome"
# A senha é aleatória e aparece UMA vez no terminal. Para escolher a senha (12+ caracteres com maiúscula,
# minúscula e número ou símbolo), passe-a só no comando:
#   docker compose exec -e SUPERADMIN_PASSWORD='Sua-Senha-Forte-1' api npm run platform:superadmin:prod -- --email=... --name="..."
# Recuperar o acesso: o mesmo comando com --reset-password (nova senha aleatória; encerra as sessões).
# NÃO defina SUPERADMIN_PASSWORD neste arquivo: ele vai inteiro para o ambiente da API, e com ela definida o
# --reset-password repetiria sempre a mesma senha.

# =====================================================================
#  PRODUÇÃO (servidor com domínio e HTTPS): o que mudar
#  - NODE_ENV=production e SEED_DEMO_USERS=false (banco novo: sem loja nem contas de demonstração; crie o
#    superadmin pelo comando e as lojas pelo superpainel ou pelo cadastro público).
#  - Segredos novos e exclusivos do servidor (nunca os desta máquina) e cópia de segurança deles em cofre.
#  - HTTPS na frente do Nginx (proxy reverso: Caddy, Traefik, Nginx do servidor ou balanceador):
#      APP_WEB_URL=https://app.seudominio.com.br
#      CORS_ORIGINS=https://app.seudominio.com.br
#      PUBLIC_API_URL=https://app.seudominio.com.br/api
#      TRUST_PROXY=2   (o proxy HTTPS + o Nginx do serviço web; o proxy precisa ACRESCENTAR o IP ao X-Forwarded-For)
#    A sessão do site em cookie passa sozinha a __Host-comestra_rt com Secure (NODE_ENV=production) e usa as origens
#    acima; o proxy HTTPS não pode registrar o cabeçalho Cookie nos logs (o Nginx do serviço web não registra).
#    e no terminal do "docker compose up": COMESTRA_HTTP_BIND=127.0.0.1 (o proxy HTTPS roda no mesmo servidor).
#  - MAIL_DRIVER=smtp com SMTP_* e MAIL_FROM (domínio com SPF/DKIM); teste em Superpainel → Configurações.
#  - PAYMENT_SANDBOX vazio (em produção nunca liga), credenciais Mercado Pago de PRODUÇÃO em cada loja e
#    MP_NOTIFICATION_URL=https://app.seudominio.com.br/api/payment/webhook
#  - SWAGGER_ENABLED=false (padrão em produção).
#  - Com lojas cobrando a entrega por distância: GEOCODING_CONTACT com um contato real da operação e, se quiser o
#    Google, GOOGLE_MAPS_API_KEY restrita à Geocoding API e à Routes API (avalie custos e termos antes).
#  - Atualizando uma instalação que já estava no ar com uma versão anterior às sessões registradas (auth_sessions):
#    defina JWT_LEGACY_ISSUED_BEFORE com o instante do deploy (ex.: 2026-11-01T12:00:00Z) para que quem já estava
#    logado (site, app e equipe) continue até o token antigo expirar. Sem ela, em produção, todos precisam entrar de
#    novo (aviso no log). Instalação nova: deixe sem.
#  - Backup diário do banco e do volume de imagens (docs/saas/docker.md).
# =====================================================================
