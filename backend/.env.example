# =====================================================================
#  Variáveis de ambiente da API
#  Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
#  Variáveis definidas no próprio ambiente (servidor, Docker, CI) têm
#  prioridade sobre o .env. Nunca versione o .env com segredos reais.
#  Valores vazios usam o padrão indicado em cada comentário.
#  Booleanos aceitam true/false, 1/0, yes/no, sim/não e on/off. Outro valor
#  (ex.: "fasle") usa o padrão e gera um aviso no log.
# =====================================================================

# --- Ambiente ---------------------------------------------------------
# development = máquina do desenvolvedor · test = testes automatizados · production = servidor.
# Vazio ou qualquer outro valor ("prod", "staging"...) também conta como PRODUÇÃO (fail closed).
# As facilidades de desenvolvimento só valem com development ou test:
#   - usuários padrão com senhas públicas (SEED_DEMO_USERS);
#   - segredo JWT fixo quando JWT_SECRET está vazio;
#   - sandbox automático de pagamentos (PAYMENT_SANDBOX vazio);
#   - DB_SYNCHRONIZE ligado por padrão.
# DESENVOLVIMENTO LOCAL: troque para NODE_ENV=development.
# O "npm run start:prod" sempre roda com NODE_ENV=production, qualquer que seja o valor aqui.
NODE_ENV=production

# Porta HTTP da API (padrão: 3000)
PORT=3000

# --- Banco de dados (PostgreSQL) -------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Vazio = sem senha (comum em instalações locais)
DB_PASSWORD=
# Vazio = identificador (slug) da marca definido em src/config/brand.ts
DB_DATABASE=
# Cria/ajusta as tabelas automaticamente a partir das entidades (pode apagar colunas).
# Vazio = ligado em development/test e DESLIGADO em produção.
# PRODUÇÃO: false, com o schema controlado por migrations. O repositório ainda não traz migrations:
# na primeira instalação, gere-as ou suba uma única vez com DB_SYNCHRONIZE=true (com backup do banco)
# e depois volte para false.
DB_SYNCHRONIZE=

# --- Autenticação (JWT) ----------------------------------------------
# Segredo para assinar e verificar os tokens.
# PRODUÇÃO: OBRIGATÓRIO, com pelo menos 32 caracteres. Sem ele (ou com menos) a API não sobe.
# Gere um valor forte (48 bytes aleatórios), por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Vazio com NODE_ENV=development/test = segredo fixo de desenvolvimento (com aviso no log).
JWT_SECRET=
# Validade do token: 7d, 12h, 30m... ou só números (segundos). Padrão: 7d
JWT_EXPIRES_IN=7d

# --- Identidade e arquivos --------------------------------------------
# Nome exibido (Swagger, GET /health...). Vazio = nome padrão da marca.
APP_NAME=
# Pasta onde as imagens enviadas são gravadas e servidas em /uploads.
# Vazio = ./uploads (relativo à pasta do backend). Em produção use um volume persistente.
UPLOADS_DIR=

# --- CORS --------------------------------------------------------------
# Origens liberadas, separadas por vírgula. Vazio = qualquer origem (somente desenvolvimento;
# em produção a subida avisa no log).
# PRODUÇÃO: informe os endereços reais do site e do painel, por exemplo:
#   CORS_ORIGINS=https://minhaloja.com.br,https://painel.minhaloja.com.br
# (o app mobile não envia o cabeçalho Origin e não é afetado)
CORS_ORIGINS=

# --- Usuários padrão (um por perfil) ----------------------------------
# Cria na subida da API, se ainda não existirem, os usuários de teste documentados no README
# (administrador, atendente, cozinha, entregador e cliente). As senhas deles são PÚBLICAS.
# Vazio = ligado com NODE_ENV=development/test. false desliga.
# Em produção eles NUNCA são criados: SEED_DEMO_USERS=true é ignorado e gera um erro no log.
# "npm run seed" também redefine as senhas; em produção ele só roda com "npm run seed -- --force".
SEED_DEMO_USERS=

# --- Pagamentos (Mercado Pago) ----------------------------------------
# Access token da conta (credenciais de teste começam com TEST-).
# Painel: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=
# Sandbox: cartão recusado ou falha do Mercado Pago vira pagamento SIMULADO aprovado e o PIX usa QR de teste.
# Vazio = sandbox ligado com NODE_ENV=development/test quando MP_ACCESS_TOKEN está vazio ou começa com TEST-.
# Em produção o sandbox nunca liga sozinho, e PAYMENT_SANDBOX=true é recusado (erro no log).
# PRODUÇÃO: access token de produção (nunca aprova pagamento em caso de erro).
PAYMENT_SANDBOX=
# No sandbox, segundos até um PIX criado ser considerado pago (padrão: 5)
PIX_SANDBOX_APPROVAL_SECONDS=5
# Validade do QR Code PIX, em minutos (padrão: 30)
PIX_EXPIRATION_MINUTES=
# URL pública do webhook enviada ao Mercado Pago (ex.: https://api.sualoja.com.br/payment/webhook).
# Vazio = os pagamentos são confirmados pela consulta de status e pela conciliação automática (60 s).
MP_NOTIFICATION_URL=

# --- Loja ---------------------------------------------------------------
# Fuso horário usado no "hoje" e nos gráficos do painel (padrão: America/Sao_Paulo)
STORE_TIME_ZONE=
# Faixas de taxa de entrega por bairro, em JSON. Vazio = faixas do arquivo de configuração do backend.
# Formato: {"fallback":{"fee":15,"time":"50-60 min"},"zones":[{"neighborhoods":["Centro"],"cities":["Rio de Janeiro"],"fee":5,"time":"30-40 min"}]}
DELIVERY_ZONES_JSON=
# Alternativa: caminho de um arquivo .json no mesmo formato (usado quando DELIVERY_ZONES_JSON está vazio)
DELIVERY_ZONES_FILE=

# --- Banner de futebol (opcional) -------------------------------------
# Token gratuito de https://www.football-data.org. Vazio = banner com a sugestão do dia.
FOOTBALL_DATA_TOKEN=
