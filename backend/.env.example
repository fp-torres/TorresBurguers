# =====================================================================
#  Variáveis de ambiente da API (plataforma Comestra SaaS multi-tenant)
#  Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
#  Variáveis definidas no próprio ambiente (servidor, Docker, CI) têm
#  prioridade sobre o .env. Nunca versione o .env com segredos reais.
#  Valores vazios usam o padrão indicado em cada comentário.
#  Booleanos aceitam true/false, 1/0, yes/no, sim/não e on/off. Outro valor
#  (ex.: "fasle") usa o padrão e gera um aviso no log.
#  Guia completo: docs/saas/operacao.md
#  Docker: a configuração fica no .env.docker da raiz do repositório (modelo: .env.docker.example),
#  com as mesmas variáveis; veja docs/saas/docker.md.
# =====================================================================

# --- Ambiente ---------------------------------------------------------
# development = máquina do desenvolvedor · test = testes automatizados · production = servidor.
# Vazio ou qualquer outro valor ("prod", "staging"...) também conta como PRODUÇÃO (fail closed).
# As facilidades de desenvolvimento só valem com development ou test:
#   - dados de demonstração (loja demo, equipe e cliente com senhas públicas: SEED_DEMO_USERS; o superadmin
#     de demonstração só com SEED_DEMO_SUPERADMIN);
#   - segredo JWT de desenvolvimento quando JWT_SECRET está vazio (development: aleatório por máquina, em
#     .temp/dev-jwt-secret; test: fixo);
#   - chave fixa de criptografia de credenciais quando CREDENTIALS_ENCRYPTION_KEY está vazia;
#   - sandbox automático de pagamentos (PAYMENT_SANDBOX vazio);
#   - Swagger em /api (SWAGGER_ENABLED vazio).
# DESENVOLVIMENTO LOCAL: troque para NODE_ENV=development.
# O "npm run start:prod" sempre roda com NODE_ENV=production, qualquer que seja o valor aqui.
NODE_ENV=production

# Porta HTTP da API (padrão: 3000)
PORT=3000
# Interface em que a API escuta. Vazio = 0.0.0.0: todas as interfaces IPv4, acessível pela rede local
# (necessário para o app mobile no celular). 127.0.0.1 = só este computador (use com túnel ou proxy reverso
# na mesma máquina). IPv6 aceito com ou sem colchetes. O log da subida mostra "escutando em <host>:<porta>".
# Atenção: variáveis do ambiente têm prioridade sobre este arquivo; alguns shells (ex.: tcsh) já exportam HOST
# com o nome da máquina. Nesse caso, defina HOST no ambiente do processo.
HOST=

# --- Banco de dados (PostgreSQL) -------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Vazio = sem senha (comum em instalações locais)
DB_PASSWORD=
# Vazio = identificador (slug) da plataforma definido em src/config/brand.ts
DB_DATABASE=
# O schema é criado e atualizado pelas MIGRATIONS (src/database/migrations).
# Aplica as migrations pendentes na subida da API, antes de tudo. Vazio = ligado.
# Várias instâncias da API: deixe false nelas e rode "npm run migration:run:prod" uma vez no deploy.
DB_MIGRATIONS_RUN=
# Synchronize do TypeORM (altera tabelas a partir das entidades, sem migration; pode apagar colunas).
# Vazio = DESLIGADO em todos os ambientes (recomendado também em desenvolvimento). Com true, o TypeORM roda
# depois das migrations e cria por fora delas índices e colunas declarados nas entidades: isso esconde uma
# migration esquecida e deixa o banco diferente do de produção. Use true só em experimentos locais.
DB_SYNCHRONIZE=
# Reversão destrutiva da migration MultiTenantFoundation (volta para a loja única). Vazio = recusada se
# houver auditoria, cobrança SaaS, sessões de suporte, convites, redefinições de senha, bloqueios ou sessões
# revogadas, porque o down() apaga ou desfaz esses dados. true só numa reversão consciente, com backup.
# Vale também para o down() da OrderNumbersAndCustomerBlocks quando há clientes bloqueados pelas lojas.
DB_ALLOW_DESTRUCTIVE_REVERT=
# Conexões no pool da API (1 a 200). Vazio = 10, o padrão do driver pg. Ao aumentar, confira o max_connections
# do PostgreSQL somando todas as instâncias.
DB_POOL_SIZE=
# Tempo máximo de cada consulta da API, em ms (statement_timeout). Vazio = 60000 (60 s); 0 desliga.
# Não vale para as migrations da subida nem para o CLI (npm run migration:*), que usam uma conexão própria.
# No Docker combina com o proxy_read_timeout de 60 s do Nginx.
DB_STATEMENT_TIMEOUT_MS=
# Espera máxima por uma conexão livre do pool, em ms. Vazio = 30000 (30 s); 0 = sem limite; máximo 600000.
# Com o pool esgotado, a requisição falha (500) em vez de esperar para sempre.
DB_POOL_ACQUIRE_TIMEOUT_MS=

# --- Migração de uma instalação de loja única (só na primeira subida desta versão) --------------
# Nome e slug da loja que recebe o cardápio, os pedidos, os pagamentos e a equipe já existentes.
# Vazio = "Loja principal" / loja-principal. Banco novo (vazio) não cria loja nenhuma.
INITIAL_STORE_NAME=
INITIAL_STORE_SLUG=

# --- Multi-tenant ------------------------------------------------------
# Loja das rotas antigas sem slug (/products, /store/status, /orders...), usadas pelo app mobile.
# Vazio = a loja padrão escolhida no superpainel (a migração define a loja inicial).
DEFAULT_STORE_SLUG=
# Endereço do site (links de convite, de redefinição de senha e dos e-mails de conta). Padrão: http://localhost:5173
APP_WEB_URL=
# URL pública da API, com http:// ou https:// (https recomendado). Base do logo das lojas nos e-mails:
# <PUBLIC_API_URL>/uploads/<arquivo>. Ex.: https://api.comestra.com.br ou https://comestra.com.br/api
# (no Docker: http://localhost:8080/api). Vazio = e-mails das lojas sem logo (monograma com a inicial).
# Valor inválido (sem http/https, com usuário e senha, ?consulta ou #âncora) = aviso na subida e e-mails sem logo.
PUBLIC_API_URL=

# --- Autenticação (JWT) ----------------------------------------------
# Segredo para assinar e verificar os tokens.
# PRODUÇÃO: OBRIGATÓRIO, com pelo menos 32 caracteres. Sem ele (ou com menos) a API não sobe.
# Gere um valor forte (48 bytes aleatórios), por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Vazio com NODE_ENV=development = a API gera um segredo aleatório por máquina em .temp/dev-jwt-secret (fora do
# Git), com aviso no log; apagar o arquivo encerra as sessões de desenvolvimento. Vazio com NODE_ENV=test = segredo
# fixo dos testes automatizados. Para expor uma API de desenvolvimento por túnel, defina um JWT_SECRET próprio.
JWT_SECRET=
# Só em development sem JWT_SECRET: caminho do arquivo do segredo aleatório. Vazio = .temp/dev-jwt-secret
JWT_DEV_SECRET_FILE=
# Validade do token: 7d, 12h, 30m... ou só números (segundos). Padrão: 7d
# É a validade do token do app mobile, das sessões antigas e da sessão de suporte, e o padrão de AUTH_SESSION_MAX_AGE.
JWT_EXPIRES_IN=7d
# Tokens SEM "jti" (emitidos antes das sessões registradas, migration AuthSessions). Informe o instante ISO 8601 do
# deploy que aplicou a AuthSessions (ex.: 2026-11-01T12:00:00Z): os tokens emitidos antes dele continuam valendo até
# esse instante + JWT_EXPIRES_IN. Vazio = em PRODUÇÃO nenhum é aceito (todos, inclusive o app mobile, entram de novo;
# o log avisa uma vez); em development/test todos valem até expirar. none/off/false/0 recusam todos; um valor
# inválido também recusa todos, com aviso. Instalação nova (sem tokens antigos): deixe vazio.
JWT_LEGACY_ISSUED_BEFORE=

# --- Sessão do site em cookie (refresh rotativo) --------------------------
# O site pede a sessão em cookie (cabeçalho X-Auth-Transport: cookie): token de acesso curto na memória da aba e
# refresh num cookie HttpOnly (__Host-comestra_rt em produção/HTTPS; comestra_rt em http fora de produção).
# O app mobile não envia o cabeçalho e continua com o token de JWT_EXPIRES_IN. Guia: docs/saas/operacao.md (7.3).
# Liga a emissão de sessões em cookie. Vazio = true. false = para de emitir na hora (as existentes renovam até vencer).
AUTH_WEB_COOKIE=
# Validade do token de acesso das sessões em cookie: de 1m a 60m. Vazio = 15m (inválido = 15m, com aviso).
JWT_ACCESS_EXPIRES_IN=
# Validade total da sessão em cookie (a renovação não estende): de 5m a 90d. Vazio = a de JWT_EXPIRES_IN.
AUTH_SESSION_MAX_AGE=
# Por quantos segundos o refresh anterior ainda vale depois de uma renovação (abas simultâneas, resposta perdida):
# de 0 a 120. Vazio = 30.
AUTH_REFRESH_GRACE_SECONDS=
# Origens do site que recebem credenciais (cookie), separadas por vírgula. Vazio = CORS_ORIGINS explícito + a origem
# de APP_WEB_URL (em development/test sem APP_WEB_URL: http://localhost:5173). "*" é ignorado. Em produção sem
# nenhuma origem, o modo cookie fica desligado (aviso na subida). Ex.: AUTH_COOKIE_ORIGINS=https://comestra.com.br
AUTH_COOKIE_ORIGINS=
# SameSite do cookie: strict (padrão) ou lax. lax em produção gera aviso.
AUTH_COOKIE_SAMESITE=

# --- Conta: verificação e troca de e-mail ---------------------------------
# compat (padrão): as rotas antigas usadas pelo app mobile não mudam; o site usa /account/* (troca de e-mail com
# confirmação no endereço novo e "Não fui eu" no antigo). strict ainda NÃO existe nesta versão: o valor é lido, a API
# segue em compat e avisa na subida. Valor inválido = compat, com aviso.
ACCOUNT_SECURITY_MODE=compat

# --- Credenciais de pagamento das lojas ---------------------------------
# Chave AES-256 (32 bytes, em base64 ou hex) que cifra o Access Token do Mercado Pago de cada loja.
# PRODUÇÃO: OBRIGATÓRIA para gravar e ler as credenciais. Guarde em cofre: trocá-la torna as credenciais
# gravadas ilegíveis (cada loja precisará informá-las de novo). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Vazio com NODE_ENV=development/test = chave fixa de desenvolvimento (com aviso no log).
CREDENTIALS_ENCRYPTION_KEY=

# --- Identidade e arquivos --------------------------------------------
# Nome da PLATAFORMA exibido (Swagger, logs da subida, e-mails). Vazio = Comestra.
# O nome, o logo e a cor de cada loja são configurados no painel da própria loja.
APP_NAME=
# Pasta onde as imagens enviadas são gravadas e servidas em /uploads.
# Vazio = ./uploads (relativo à pasta do backend). Em produção use um volume persistente.
UPLOADS_DIR=
# Limpeza automática dos arquivos sem uso da pasta de uploads, em horas (vazio = desligada). Apaga só imagens sem
# uso há mais de 24 h (as mesmas regras do botão "Apagar sem uso" do superpainel). Decimais aceitos (0.5 = 30 min;
# mínimo 10 s); 0 ou off = desligada; inválido = desligada, com aviso. Faça backup da pasta antes de ligar. Ex.: 24
UPLOADS_CLEANUP_INTERVAL_HOURS=
# Documentação interativa em /api. Vazio = ligada em development/test e DESLIGADA em produção.
SWAGGER_ENABLED=

# --- CORS e rede -------------------------------------------------------
# Origens liberadas, separadas por vírgula. Vazio = qualquer origem (somente desenvolvimento;
# em produção a subida avisa no log).
# PRODUÇÃO: informe os endereços reais do site e do painel, por exemplo:
#   CORS_ORIGINS=https://comestra.com.br,https://www.comestra.com.br
# (o app mobile não envia o cabeçalho Origin e não é afetado)
CORS_ORIGINS=
# Atrás de proxy/túnel/balanceador (Nginx, ngrok, Serveo...). Vazio = desligado.
# Número de proxies na frente da API (ex.: 1) ou lista de IPs/sub-redes desses proxies (ex.: loopback,10.0.0.0/8).
# true é tratado como 1 (com aviso no log): no Express, true confiaria no X-Forwarded-For inteiro e o cliente
# escolheria o próprio IP. Cadeias com 2+ proxies: informe o número exato (ex.: 2 = proxy HTTPS + Nginx do Docker).
# Use CIDR IPv4 simples (10.0.0.0/8), nunca sub-rede IPv4-mapeada em IPv6 com prefixo curto (::ffff:10.0.0.0/8).
# Define o IP real usado na auditoria e nos limites por IP (login, cadastro, pedidos, cobranças, webhook do
# delivery). Sem ele, atrás de um proxy todos os clientes caem num só balde (o IP do proxy); a API avisa
# uma vez no log quando recebe X-Forwarded-For/Forwarded com TRUST_PROXY vazio.
# Não ligue sem um proxy de verdade na frente (o cliente poderia forjar o próprio IP).
TRUST_PROXY=

# --- Limites de tentativas e de abuso (em memória, por instância) -------
# Vazio = ligado. false desliga TODOS os limites (inclusive o teto de pedidos pendentes pagos na entrega).
# Ajuste fino por política: RATE_LIMIT_<NOME>=limite/segundos, ex.: RATE_LIMIT_SIGNUP=30/3600
# Políticas e padrões:
#   LOGIN_FAILURES (IP + e-mail) 10/900 · LOGIN_FAILURES_IP 100/900
#   LOGIN_FAILURES_ACCOUNT 50/3600 (falhas por conta somando todos os IPs; acima dele, só a senha certa vinda de um
#   IP com sessão ativa da conta entra) · LOGIN_SUCCESS 200/600 (logins certos por IP + e-mail)
#   FORGOT_PASSWORD 5/900 (por IP; além disso, no máximo 3 links por conta em 24 h, contados no banco)
#   TOKEN_REDEEM 20/900 (links de redefinição, convite e de conta, por IP)
#   SIGNUP 30/3600 (por IP) · STORE_SIGNUP 5/3600 · CEP_LOOKUP 60/60
#   ORDER_CREATE 10/600 (loja + cliente; também é o teto de pedidos PENDING pagos na entrega por cliente e loja)
#   ORDER_CREATE_IP 60/600 · PAYMENT_CREATE 10/600 (PIX/cartão do delivery, cliente + loja)
#   PAYMENT_CREATE_IP 60/600 · PAYMENT_WEBHOOK 300/60 (webhook do delivery, por IP)
#   UPLOAD 30/600 (imagens, por conta ou IP) · ADDRESS_WRITE 30/600 (por conta)
#   TEAM_WRITE 30/600 (equipe e convites, por loja) · CREDENTIALS_CHANGE 10/900 (falhas na troca da própria
#   senha/e-mail, por conta e por IP) · TEST_EMAIL 5/600 (e-mail de teste do superpainel, por operador)
#   ACCOUNT_EMAIL 5/3600 (pedidos de confirmação e de troca do próprio e-mail, por conta; 429)
#   ACCOUNT_EMAIL_TARGET 3/3600 (e-mails de confirmação/troca por endereço de destino; silencioso)
#   REFRESH 120/300 (renovações da sessão do site em cookie, por IP)
#   SUBSCRIPTION_CHECKOUT 10/600 (links de pagamento da assinatura, por loja)
# As chaves por IP agrupam o IPv6 por /64. Com várias instâncias da API, cada uma conta separado (armazenamento
# compartilhado é evolução futura).
RATE_LIMIT_ENABLED=
# Exemplos: RATE_LIMIT_TEST_EMAIL=5/600 · RATE_LIMIT_LOGIN_SUCCESS=200/600 · RATE_LIMIT_LOGIN_FAILURES_ACCOUNT=50/3600
# RATE_LIMIT_SUBSCRIPTION_CHECKOUT=10/600

# --- E-mail transacional (convites, redefinição de senha, e-mail de teste do superpainel) -------
# log  = nada é enviado: em development/test o texto completo (com o link) vai para o log da API; em produção
#        só o destinatário e o assunto, e a subida avisa no log (convites e links não chegam às pessoas).
# smtp = envia pelo servidor abaixo (nodemailer). Teste em Superpainel → Configurações → E-mail transacional.
# Vazio = log. Valor desconhecido = log, com aviso na subida.
MAIL_DRIVER=log
# Servidor SMTP (obrigatório com smtp). Ex.: smtp.seuprovedor.com.br
# Desenvolvimento com Mailpit/MailHog local: SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false, sem usuário.
SMTP_HOST=
# Porta: 587 (STARTTLS) ou 465 (TLS desde o início, com SMTP_SECURE=true). Vazio = 587, ou 465 com SMTP_SECURE=true.
SMTP_PORT=
# TLS desde o início da conexão. Vazio = ligado só na porta 465. Desligado, usa STARTTLS quando o servidor
# oferece, e o EXIGE quando SMTP_USER/SMTP_PASSWORD estão definidos (as credenciais nunca trafegam abertas).
SMTP_SECURE=
# Usuário e senha do SMTP: opcionais, mas sempre juntos. Nunca aparecem em respostas, logs, auditoria nem no
# superpainel. Em produção, prefira defini-los no ambiente do servidor ou num cofre.
SMTP_USER=
SMTP_PASSWORD=
# Remetente (obrigatório com smtp): "Nome <endereco@dominio>" ou só o endereço, uma linha, até 200 caracteres.
# Use aspas por causa dos espaços e dos sinais < >, e um domínio com SPF/DKIM configurados no provedor.
# Ex.: MAIL_FROM="Comestra <nao-responda@seudominio.com.br>"
MAIL_FROM=

# --- Usuários e loja de demonstração ----------------------------------
# Cria na subida da API, se ainda não existirem: a loja demo (só num banco sem lojas), a equipe demo
# (administrador, atendente, cozinha, entregador) e um cliente. As senhas são PÚBLICAS (README).
# Vazio = ligado com NODE_ENV=development/test. false desliga.
# Em produção eles NUNCA são criados: SEED_DEMO_USERS=true é ignorado e gera um erro no log.
# "npm run seed" também redefine as senhas; ele se recusa a rodar em produção (o antigo --force não existe mais).
# Desligue (false) numa API de desenvolvimento exposta na rede ou por túnel (ex.: npm run tunnel do app).
SEED_DEMO_USERS=
# Superadmin de DEMONSTRAÇÃO (superadmin@<domínio>, senha pública, papel global sobre TODAS as lojas).
# Vazio = ligado em NODE_ENV=test (suíte E2E) e DESLIGADO em development; em produção, nunca.
# Em development, true só numa máquina isolada (sem túnel nem acesso pela rede). Alternativa pontual:
# npm run seed -- --with-superadmin. Bancos antigos podem já ter essa conta: a subida avisa no log; troque a
# senha (npm run platform:superadmin -- --email=superadmin@comestra.com.br --reset-password) ou use --revoke.
SEED_DEMO_SUPERADMIN=

# --- Superadministrador (comando npm run platform:superadmin) ----------
# O papel global nunca é concedido por HTTP. Crie o primeiro superadmin no servidor:
#   npm run platform:superadmin -- --email=ops@empresa.com.br --name="Nome"        (desenvolvimento)
#   npm run platform:superadmin:prod -- --email=ops@empresa.com.br --name="Nome"   (produção, após o build)
# Opções: --promote-existing (promove uma conta de cliente já existente: troca a senha e encerra as sessões),
# --reset-password (nova senha para um superadmin) e --revoke (remove o papel).
# Senha usada pelo comando no lugar da aleatória (mínimo de 12 caracteres, com maiúscula, minúscula e número ou
# símbolo). Prefira defini-la só no ambiente do próprio comando e não deixá-la gravada aqui.
SUPERADMIN_PASSWORD=

# --- Pagamentos do delivery (Mercado Pago) ----------------------------
# Cada loja informa as próprias credenciais no painel (Configurações → Pagamentos).
# As variáveis abaixo valem SÓ para a loja padrão sem credencial própria (compatibilidade com a
# instalação de loja única e o app mobile).
# Access token da conta (credenciais de teste começam com TEST-).
# Painel: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=
# Chave PÚBLICA da mesma conta (exibida no perfil público da loja padrão para tokenizar o cartão).
MP_PUBLIC_KEY=
# Sandbox: cartão recusado ou falha do Mercado Pago vira pagamento SIMULADO aprovado e o PIX usa QR de teste.
# Vazio = sandbox ligado com NODE_ENV=development/test quando MP_ACCESS_TOKEN está vazio ou começa com TEST-.
# Em produção o sandbox nunca liga sozinho, e PAYMENT_SANDBOX=true é recusado (erro no log).
# PRODUÇÃO: access token de produção (nunca aprova pagamento em caso de erro).
PAYMENT_SANDBOX=
# No sandbox, segundos até um PIX criado ser considerado pago (padrão: 5)
PIX_SANDBOX_APPROVAL_SECONDS=5
# Validade do QR Code PIX, em minutos (padrão: 30; mínimo 30, exigido pelo Mercado Pago; máximo 30 dias).
# Prazos longos mantêm cobranças pendentes por mais tempo (cada cliente pode ter até 5 pendentes por loja).
PIX_EXPIRATION_MINUTES=
# URL pública do webhook enviada ao Mercado Pago (ex.: https://api.comestra.com.br/payment/webhook).
# Vazio = os pagamentos são confirmados pela consulta de status e pela conciliação automática (60 s).
# O corpo do webhook não é confiável: cada pagamento é reconsultado no Mercado Pago com a credencial da loja
# (no máximo uma vez a cada 15 s). Limite por IP: RATE_LIMIT_PAYMENT_WEBHOOK (configure TRUST_PROXY atrás de proxy).
MP_NOTIFICATION_URL=

# --- Cobrança da assinatura SaaS (loja → plataforma) -------------------
# Totalmente separada dos pagamentos do delivery: outra conta, outro webhook, outras tabelas.
# MANUAL = faturas registradas pelo superadmin · MERCADO_PAGO = assinatura recorrente (preapproval).
SAAS_BILLING_PROVIDER=MANUAL
# Access token da conta Mercado Pago DA PLATAFORMA (nunca a de uma loja). Necessário para MERCADO_PAGO.
MP_SAAS_ACCESS_TOKEN=
# Segredo de assinatura das notificações (webhook POST /billing/webhook/mercadopago, cadastrado no painel MP).
# Com MANUAL e sem MP_SAAS_ACCESS_TOKEN, o webhook responde 200 e registra a notificação como IGNORED.
MP_SAAS_WEBHOOK_SECRET=
# Página de retorno depois do pagamento da assinatura (ex.: https://comestra.com.br/subscription)
SAAS_BILLING_BACK_URL=
# Intervalo da rotina de assinaturas (teste, vencimento, tolerância, renovação), em ms.
# Padrão: 300000 (5 min); mínimo: 10000. Valor inválido usa o padrão, com aviso no log.
SAAS_BILLING_INTERVAL_MS=

# --- Superpainel ------------------------------------------------------------
# Por quanto tempo (ms) o dashboard e o financeiro do superpainel reaproveitam o último resultado.
# Vazio = 30000 (30 s); 0 desliga (os testes E2E usam 0). Máximo 3600000.
PLATFORM_INSIGHTS_CACHE_MS=

# --- Padrões da plataforma para as lojas ------------------------------------
# Fuso usado quando uma loja não tem o próprio (padrão: America/Sao_Paulo).
STORE_TIME_ZONE=
# Faixas de taxa de entrega por bairro da LOJA PADRÃO (as demais lojas configuram as próprias zonas no
# painel; sem zonas, elas não fazem entrega). Vazio = faixas do arquivo de configuração do backend.
# Formato: {"fallback":{"fee":15,"time":"50-60 min"},"zones":[{"neighborhoods":["Centro"],"cities":["Rio de Janeiro"],"fee":5,"time":"30-40 min"}]}
DELIVERY_ZONES_JSON=
# Alternativa: caminho de um arquivo .json no mesmo formato (usado quando DELIVERY_ZONES_JSON está vazio)
DELIVERY_ZONES_FILE=
# Estas zonas da plataforma são sempre por bairro/CEP. "min_order", "free_delivery_above" e "min_order_takeout"
# são aceitos e validados aqui, mas IGNORADOS: pedido mínimo, frete grátis e entrega por distância só valem nas
# zonas que a própria loja salva no painel (Configurações → Entrega).

# --- Entrega por distância: localização dos endereços no mapa (opcional) ----------------------
# Só é usada quando alguma loja escolhe "Por distância (km)" no painel. Sem nenhuma loja assim, a API não envia
# endereços a nenhum serviço de mapa.
#
# Chave do Google Maps Platform (Geocoding API + Routes API habilitadas, com faturamento ativo; serviço PAGO acima
# da cota gratuita mensal). Liga o Google no início da cadeia e a opção "Usar a distância real pelas ruas" no
# painel. Restrinja a chave a essas duas APIs e ao IP do servidor. Vazio = sem Google (Nominatim + AwesomeAPI).
# Confira custos e termos de uso em docs/saas/operacao.md (seção 8.4) antes de usar em produção.
GOOGLE_MAPS_API_KEY=
# Ordem da cadeia (separada por vírgula). Vazio = google,nominatim,awesomeapi (o Google é pulado sem a chave).
# Nomes desconhecidos são ignorados com aviso; "none" desliga a localização (as lojas por distância passam a
# aplicar a regra de fora da área a todos os endereços). Ex.: GEOCODING_PROVIDERS=nominatim,awesomeapi
GEOCODING_PROVIDERS=
# Contato (e-mail ou site) enviado no User-Agent ao Nominatim, como pede a política de uso dele. Recomendado sempre
# que o Nominatim estiver na cadeia (sem ele, a API avisa na subida). Ex.: GEOCODING_CONTACT=ops@seudominio.com.br
GEOCODING_CONTACT=
# Servidor Nominatim próprio ou contratado. Vazio = https://nominatim.openstreetmap.org (público: no máximo 1
# requisição por segundo, respeitado POR INSTÂNCIA da API; com várias instâncias, use um servidor próprio ou o Google).
GEOCODING_NOMINATIM_URL=

# --- Banner de futebol (opcional) -------------------------------------
# Token gratuito de https://www.football-data.org. Vazio = banner com a sugestão do dia.
FOOTBALL_DATA_TOKEN=

# --- Somente testes automatizados (NODE_ENV=test) ------------------------
# CEP falso: mapa JSON que substitui ViaCEP e BrasilAPI na busca de CEP e na conferência do bairro. Ignorado, com
# aviso, fora de NODE_ENV=test. NUNCA use em produção. CEP fora do mapa = inexistente; "unavailable" = serviço fora
# do ar. Exemplo (uma linha):
# CEP_LOOKUP_FAKE={"22071900":{"logradouro":"Rua do Frete E2E","bairro":"Copacabana","localidade":"Rio de Janeiro","uf":"RJ"},"28999999":"unavailable"}
# Localização falsa (entrega por distância): mapa JSON de CEP → coordenadas no lugar de Google, Nominatim e
# AwesomeAPI. Ignorado, com aviso, fora de NODE_ENV=test. NUNCA use em produção. CEP fora do mapa ou null = não
# encontrado; "unavailable" = serviços fora do ar; "precision":"ZIP_CENTER" = só o centro do CEP. Em NODE_ENV=test
# sem ela, nenhum endereço é localizado (nenhuma chamada externa). A suíte E2E usa e2e/support/geocoding-fake.ts.
# Exemplo (uma linha):
# GEOCODING_FAKE={"28970000":{"lat":-22.9035,"lng":-43.2096},"28970001":{"lat":-22.894507,"lng":-43.2096},"28970098":"unavailable","28970099":null}
