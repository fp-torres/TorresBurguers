# =============================================================================
# App mobile (Expo) — variáveis de ambiente
# Copie para .env (ou .env.local, que não vai para o git) e ajuste se precisar.
# Variáveis EXPO_PUBLIC_* entram no bundle: depois de mudar, reinicie com
#   npx expo start --clear
# =============================================================================

# Endereço da API (NestJS). Deixe VAZIO no dia a dia — o app escolhe sozinho:
#
# 1) Rede local (automático): celular e computador no mesmo Wi-Fi.
#    Rode "npm run start:lan"; o app usa o IP da máquina que roda o Expo, porta 3000
#    (ex.: http://192.168.0.10:3000). Libere a porta 3000 no firewall do computador.
#
# 2) Emulador Android: automático. Com "npm run android" o modo LAN já funciona, e se o Expo
#    estiver em localhost/127.0.0.1 o app troca sozinho para 10.0.2.2 (o PC visto pelo emulador).
#    Celular Android via USB com "adb reverse tcp:3000 tcp:3000": defina http://127.0.0.1:3000
#    (sem isso o app usaria 10.0.2.2, que só existe no emulador).
#    Simulador iOS / navegador: http://localhost:3000
#
# 3) Túnel (rede corporativa, 4G, celular fora da rede do PC):
#    "npm run tunnel" abre um túnel Serveo e grava a URL pública aqui no .env.local;
#    depois, em outro terminal: npx expo start --tunnel --clear
#    Ao encerrar o túnel (Ctrl+C ou fechando o terminal) a variável é removida automaticamente.
EXPO_PUBLIC_API_URL=

# Porta da API usada no endereço automático (modos 1 e 2). Padrão: 3000
EXPO_PUBLIC_API_PORT=

# Nome exibido no app (opcional). Padrão: o nome definido em src/config/brand.ts
EXPO_PUBLIC_APP_NAME=

# Chave PÚBLICA do Mercado Pago usada para tokenizar cartões no aparelho.
# Sem valor, o app usa a chave de TESTE (sandbox). Em produção use a chave pública real (APP_USR-...).
EXPO_PUBLIC_MP_PUBLIC_KEY=

# Fuso horário da loja: define o "hoje" dos indicadores do painel (o mesmo STORE_TIME_ZONE da API).
# Vazio = America/Sao_Paulo
EXPO_PUBLIC_STORE_TIME_ZONE=

# Dados da loja no rodapé (opcionais; vazio = valores de demonstração de src/config/brand.ts)
EXPO_PUBLIC_STORE_ADDRESS_LINE=
EXPO_PUBLIC_STORE_CITY_LINE=

# Redes sociais (URLs completas, ex.: https://instagram.com/sualoja). Só as preenchidas aparecem.
EXPO_PUBLIC_INSTAGRAM_URL=
EXPO_PUBLIC_FACEBOOK_URL=
EXPO_PUBLIC_X_URL=
