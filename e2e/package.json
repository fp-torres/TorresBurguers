{
  "name": "e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Testes ponta a ponta (API + Web) com Playwright",
  "scripts": {
    "test": "node scripts/prepare.mjs && playwright test",
    "test:api": "node scripts/prepare.mjs && playwright test --project=api",
    "test:web": "node scripts/prepare.mjs && playwright test --project=web",
    "report": "playwright show-report",
    "reset-db": "node scripts/reset-db.mjs",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.7",
    "pg": "^8.18.0",
    "typescript": "~5.9.3"
  }
}
